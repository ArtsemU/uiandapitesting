<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <pattern>%d{HH:mm:ss} %highlight{%-5level}{INFO=cyan, ERROR=bright_red, WARN=yellow, DEBUG=white} %logger{1} - %msg%n</pattern>
<!--                <pattern>%d{HH:mm:ss} [%t] %highlight{%-5level}{INFO=cyan, ERROR=bright_red, WARN=yellow, DEBUG=white} %logger{36} - %msg%n</pattern>-->
            </PatternLayout>
        </Console>

        <!--<File name="File" fileName="logs/test.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </File>-->

    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
<!--            <AppenderRef ref="File"/>-->
        </Root>
    </Loggers>

</Configuration>